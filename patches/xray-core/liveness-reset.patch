diff --git a/app/observatory/liveness/reset.go b/app/observatory/liveness/reset.go
new file mode 100644
index 0000000..1d697f5
--- /dev/null
+++ b/app/observatory/liveness/reset.go
@@ -0,0 +1,23 @@
+package liveness
+
+import "time"
+
+// Reset turns tracking off and forgets what it found (FloxcoreXrayLib). The
+// state of this package is global, while xray-core restarts within the app's
+// process with each new configuration. Without a reset, an outbound demoted
+// before the restart would be passed over until its next health check, and
+// an outbound tag that now dials another server would stay grouped with the
+// server of its first dial. The connections of the last instance that end
+// after the reset, such as those its close cuts off, do not count either.
+// Call it before the next instance is created.
+func Reset() {
+	enabled.Store(false)
+	mu.Lock()
+	defer mu.Unlock()
+	generation++
+	rule = Rule{}
+	events = map[string][]event{}
+	servers = map[string]string{}
+	demoted = map[string]time.Time{}
+	heldBack = map[string]time.Time{}
+}
diff --git a/app/observatory/liveness/reset_test.go b/app/observatory/liveness/reset_test.go
new file mode 100644
index 0000000..363e77c
--- /dev/null
+++ b/app/observatory/liveness/reset_test.go
@@ -0,0 +1,61 @@
+package liveness
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+func TestResetForgetsTheLastInstance(t *testing.T) {
+	start(t, Rule{Failures: 2, Window: 20 * time.Second})
+	SetServer("a-h3", "192.0.2.1:443")
+	SetServer("a-h2", "192.0.2.1:443")
+	fail("a-h3", 2)
+	if !Demoted("a-h3") {
+		t.Fatal("not demoted")
+	}
+
+	Reset()
+	if Enabled() || Demoted("a-h3") || SiblingDemoted("a-h2") {
+		t.Fatal("tracking is still on after the reset")
+	}
+
+	Configure(Rule{Failures: 2, Window: 20 * time.Second})
+	if Demoted("a-h3") {
+		t.Fatal("the demotion of the last instance lasted")
+	}
+	SetServer("a-h3", "192.0.2.9:443")
+	if Server("a-h3") != "192.0.2.9:443" {
+		t.Fatal("the server of the last instance's first dial lasted")
+	}
+	fail("a-h3", 1)
+	if Demoted("a-h3") {
+		t.Fatal("the outcomes of the last instance still count")
+	}
+}
+
+// A connection of the last instance that ends after the reset, as the
+// connections that its close cuts off do, does not count for the outbound of
+// the same tag in the next instance.
+func TestResetDropsTheOutcomesOfTheLastInstance(t *testing.T) {
+	start(t, Rule{Failures: 1, Window: 20 * time.Second, ReplyTimeout: time.Hour})
+	cutOff := Watch(context.Background(), "a", "192.0.2.1:443", buf.Discard)
+
+	Reset()
+	Configure(Rule{Failures: 1, Window: 20 * time.Second, ReplyTimeout: time.Hour})
+	Done(cutOff)
+	if ok, failed := outcomes("a"); ok+failed != 0 {
+		t.Fatalf("the next instance has %d outcomes of the last instance", ok+failed)
+	}
+	if Demoted("a") {
+		t.Fatal("a connection of the last instance demoted the outbound")
+	}
+
+	current := Watch(context.Background(), "a", "192.0.2.1:443", buf.Discard)
+	Done(current)
+	if !Demoted("a") {
+		t.Fatal("a connection of the current instance does not count")
+	}
+}

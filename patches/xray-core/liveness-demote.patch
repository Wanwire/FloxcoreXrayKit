+package conf_test
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/router"
+	. "github.com/xtls/xray-core/infra/conf"
+	"google.golang.org/protobuf/proto"
+)
+
+// Wanwire: leastLoad's "demote" settings reach router.StrategyLeastLoadDemote.
+func TestLeastLoadDemoteSettings(t *testing.T) {
+	for _, c := range []struct {
+		settings string
+		want     *router.StrategyLeastLoadDemote
+	}{
+		{`{"expected": 2, "demote": {"failures": 3, "window": "20s", "replyTimeout": "5s",
+			"minReplyBytes": 1}}`,
+			&router.StrategyLeastLoadDemote{Failures: 3, Window: int64(20 * time.Second),
+				ReplyTimeout: int64(5 * time.Second), MinReplyBytes: 1}},
+		{`{"expected": 2, "demote": {"failures": 4}}`,
+			&router.StrategyLeastLoadDemote{Failures: 4}},
+		{`{"expected": 2, "demote": {"failures": 0, "window": "20s"}}`, nil},
+		{`{"expected": 2}`, nil},
+	} {
+		config := new(RouterConfig)
+		input := `{"balancers": [{"tag": "b", "selector": ["proxy"],
+			"strategy": {"type": "leastLoad", "settings": ` + c.settings + `}}]}`
+		if err := json.Unmarshal([]byte(input), config); err != nil {
+			t.Fatal(err)
+		}
+		built, err := config.Build()
+		if err != nil {
+			t.Fatal(err)
+		}
+		instance, err := built.BalancingRule[0].StrategySettings.GetInstance()
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := instance.(*router.StrategyLeastLoadConfig).GetDemote()
+		if !proto.Equal(got, c.want) {
+			t.Errorf("%s: got %v, want %v", c.settings, got, c.want)
+		}
+	}
+}

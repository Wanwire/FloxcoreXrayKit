+package router
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/observatory"
+	"github.com/xtls/xray-core/app/observatory/liveness"
+	"github.com/xtls/xray-core/common/buf"
+	"google.golang.org/protobuf/proto"
+)
+
+func tags(nodes []*node) []string {
+	var out []string
+	for _, n := range nodes {
+		out = append(out, n.Tag)
+	}
+	return out
+}
+
+func same(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// Wanwire: the leastLoad strategy turns liveness tracking on from its
+// settings, leaves out a demoted outbound unless none would be left, and
+// tries the other outbounds of its server after those of other servers.
+func TestLeastLoadPrefersLiveOutbounds(t *testing.T) {
+	NewLeastLoadStrategy(&StrategyLeastLoadConfig{
+		Demote: &StrategyLeastLoadDemote{Failures: 2, Window: int64(time.Minute),
+			ReplyTimeout: int64(time.Minute)},
+	})
+	if !liveness.Enabled() {
+		t.Fatal("demote settings did not turn liveness tracking on")
+	}
+	liveness.SetServer("dead-h3", "192.0.2.1:443")
+	liveness.SetServer("dead-h2", "192.0.2.1:443")
+	liveness.SetServer("live", "192.0.2.2:443")
+	for i := 0; i < 2; i++ {
+		liveness.Done(liveness.Watch(context.Background(), "dead-h3", "tcp:example.com:443",
+			buf.Discard))
+	}
+	got := preferLive([]*node{{Tag: "dead-h3"}, {Tag: "dead-h2"}, {Tag: "live"}})
+	if !same(tags(got), []string{"dead-h2", "live"}) {
+		t.Fatalf("got %v, want the demoted outbound left out", tags(got))
+	}
+	if got := spreadServers(got, nil); !same(tags(got), []string{"live", "dead-h2"}) {
+		t.Fatalf("got %v, want the demoted outbound's sibling last", tags(got))
+	}
+	if got := preferLive([]*node{{Tag: "dead-h3"}}); len(got) != 1 {
+		t.Fatal("left out the only outbound there is")
+	}
+}
+
+func TestSpreadServers(t *testing.T) {
+	NewLeastLoadStrategy(&StrategyLeastLoadConfig{Demote: &StrategyLeastLoadDemote{Failures: 3}})
+	liveness.SetServer("a-h3", "192.0.2.10:443")
+	liveness.SetServer("a-h2", "192.0.2.10:443")
+	liveness.SetServer("b-r", "192.0.2.11:443")
+	got := spreadServers([]*node{{Tag: "a-h3"}, {Tag: "a-h2"}, {Tag: "b-r"}, {Tag: "new"}}, nil)
+	if want := []string{"a-h3", "b-r", "new", "a-h2"}; !same(tags(got), want) {
+		t.Fatalf("got %v, want %v", tags(got), want)
+	}
+}
+
+// Wanwire: the other transports of a server whose outbound the health checks
+// found dead come after the outbounds of the other servers, and among such
+// servers the picks still spread.
+func TestSpreadServersDeadSibling(t *testing.T) {
+	NewLeastLoadStrategy(&StrategyLeastLoadConfig{Demote: &StrategyLeastLoadDemote{Failures: 3}})
+	liveness.SetServer("d-r", "192.0.2.20:443")
+	liveness.SetServer("d-h3", "192.0.2.20:443")
+	liveness.SetServer("e-h3", "192.0.2.21:443")
+	liveness.SetServer("f-r", "192.0.2.22:443")
+	got := spreadServers([]*node{{Tag: "d-h3"}, {Tag: "e-h3"}, {Tag: "f-r"}}, serversOf([]string{"d-r"}))
+	if want := []string{"e-h3", "f-r", "d-h3"}; !same(tags(got), want) {
+		t.Fatalf("got %v, want %v", tags(got), want)
+	}
+
+	// UDP throttled: every server has a dead h3, and its REALITY and h2 still
+	// spread over the servers.
+	for _, tag := range []string{"x-h3", "x-r", "x-h2"} {
+		liveness.SetServer(tag, "192.0.2.30:443")
+	}
+	for _, tag := range []string{"y-h3", "y-r", "y-h2"} {
+		liveness.SetServer(tag, "192.0.2.31:443")
+	}
+	got = spreadServers([]*node{{Tag: "x-r"}, {Tag: "x-h2"}, {Tag: "y-r"}, {Tag: "y-h2"}},
+		serversOf([]string{"x-h3", "y-h3"}))
+	if want := []string{"x-r", "y-r", "x-h2", "y-h2"}; !same(tags(got), want) {
+		t.Fatalf("got %v, want %v", tags(got), want)
+	}
+}
+
+type fakeObservatory struct {
+	result *observatory.ObservationResult
+}
+
+func (fakeObservatory) Type() interface{} { return nil }
+func (fakeObservatory) Start() error      { return nil }
+func (fakeObservatory) Close() error      { return nil }
+func (f fakeObservatory) GetObservation(context.Context) (proto.Message, error) {
+	return f.result, nil
+}
+
+// Wanwire: getNodes reports the candidates that are dead, and leaves out the
+// dead outbounds of other balancers.
+func TestGetNodesReportsDeadCandidates(t *testing.T) {
+	s := NewLeastLoadStrategy(&StrategyLeastLoadConfig{Demote: &StrategyLeastLoadDemote{Failures: 3}})
+	s.observer = fakeObservatory{result: &observatory.ObservationResult{Status: []*observatory.OutboundStatus{
+		{OutboundTag: "a-r", Alive: false},
+		{OutboundTag: "a-h3", Alive: true, Delay: 20},
+		{OutboundTag: "b-r", Alive: true, Delay: 10},
+		{OutboundTag: "other", Alive: false},
+	}}}
+	nodes, dead := s.getNodes([]string{"a-r", "a-h3", "b-r"})
+	if !same(tags(nodes), []string{"b-r", "a-h3"}) {
+		t.Fatalf("got nodes %v", tags(nodes))
+	}
+	if !same(dead, []string{"a-r"}) {
+		t.Fatalf("got dead %v, want [a-r]", dead)
+	}
+}

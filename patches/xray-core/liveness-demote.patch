index 000000000..e7d6bbb44
--- /dev/null
+++ b/app/observatory/liveness/liveness_test.go
@@ -0,0 +1,223 @@
+package liveness
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+)
+
+// start resets the package and turns tracking on with r on a fake clock;
+// the returned pointer moves the clock.
+func start(t *testing.T, r Rule) *time.Time {
+	t.Helper()
+	mu.Lock()
+	events = map[string][]event{}
+	servers = map[string]string{}
+	demoted = map[string]time.Time{}
+	heldBack = map[string]time.Time{}
+	rule = Rule{}
+	mu.Unlock()
+	enabled.Store(false)
+	clock := time.Unix(1_000_000, 0)
+	now = func() time.Time { return clock }
+	t.Cleanup(func() {
+		now = time.Now
+		enabled.Store(false)
+	})
+	Configure(r)
+	return &clock
+}
+
+func outcomes(tag string) (ok, failed int) {
+	mu.Lock()
+	defer mu.Unlock()
+	for _, e := range events[tag] {
+		if e.ok {
+			ok++
+		} else {
+			failed++
+		}
+	}
+	return
+}
+
+func bytes(n int) buf.MultiBuffer {
+	b := buf.New()
+	common.Must2(b.Write(make([]byte, n)))
+	return buf.MultiBuffer{b}
+}
+
+func fail(tag string, n int) {
+	for i := 0; i < n; i++ {
+		note(tag, false)
+	}
+}
+
+func TestDemotedAfterFailuresInARow(t *testing.T) {
+	start(t, Rule{Failures: 3, Window: 20 * time.Second})
+	fail("a", 2)
+	if Demoted("a") {
+		t.Fatal("demoted after 2 of 3 failures")
+	}
+	fail("a", 1)
+	if !Demoted("a") {
+		t.Fatal("not demoted after 3 failures in a row")
+	}
+	if Demoted("b") {
+		t.Fatal("an outbound without outcomes is demoted")
+	}
+}
+
+func TestEarlierSuccessDoesNotHoldBack(t *testing.T) {
+	clock := start(t, Rule{Failures: 3, Window: 20 * time.Second, ReplyTimeout: 5 * time.Second})
+	note("a", true) // the reply that came just before the outage
+	*clock = clock.Add(6 * time.Second)
+	fail("a", 3)
+	if !Demoted("a") {
+		t.Fatal("a success older than the reply timeout held the demotion back")
+	}
+}
+
+func TestRecentReplyHoldsBack(t *testing.T) {
+	clock := start(t, Rule{Failures: 3, Window: 20 * time.Second, ReplyTimeout: 5 * time.Second})
+	note("a", true)
+	*clock = clock.Add(time.Second)
+	fail("a", 3)
+	if Demoted("a") {
+		t.Fatal("demoted although a connection got a reply 1 s before")
+	}
+	*clock = clock.Add(3 * time.Second)
+	if Demoted("a") {
+		t.Fatal("demoted within the reply timeout of the last reply")
+	}
+	*clock = clock.Add(2 * time.Second) // nothing answered for 6 s
+	if !Demoted("a") {
+		t.Fatal("not demoted once the reply timeout passed without a reply")
+	}
+}
+
+func TestSuccessBreaksTheRow(t *testing.T) {
+	start(t, Rule{Failures: 3, Window: 20 * time.Second})
+	fail("a", 2)
+	note("a", true)
+	fail("a", 2)
+	if Demoted("a") {
+		t.Fatal("demoted although a reply came between the failures")
+	}
+}
+
+func TestOldFailuresDoNotCount(t *testing.T) {
+	clock := start(t, Rule{Failures: 3, Window: 20 * time.Second})
+	fail("a", 2)
+	*clock = clock.Add(21 * time.Second)
+	fail("a", 1)
+	if Demoted("a") {
+		t.Fatal("failures older than the window counted")
+	}
+	fail("a", 2)
+	if !Demoted("a") {
+		t.Fatal("3 failures within the window did not demote")
+	}
+}
+
+func TestOnlyTheOutboundIsDemoted(t *testing.T) {
+	start(t, Rule{Failures: 3, Window: 20 * time.Second})
+	SetServer("s-h2", "192.0.2.1:443")
+	SetServer("s-h3", "192.0.2.1:443")
+	SetServer("r", "192.0.2.2:443")
+	SetServer("s-h3", "192.0.2.9:443") // the first dial counts
+	if Server("s-h3") != "192.0.2.1:443" || Server("x") == Server("y") {
+		t.Fatal("wrong server keys")
+	}
+	fail("s-h3", 3)
+	if !Demoted("s-h3") {
+		t.Fatal("not demoted")
+	}
+	if Demoted("s-h2") {
+		t.Fatal("the other transport of the same server was demoted with it")
+	}
+	if !SiblingDemoted("s-h2") {
+		t.Fatal("the other transport of the server is not marked to go last")
+	}
+	if SiblingDemoted("s-h3") || SiblingDemoted("r") || SiblingDemoted("x") {
+		t.Fatal("an outbound without a demoted sibling is marked to go last")
+	}
+}
+
+func TestDemotionLastsUntilItsNextProbe(t *testing.T) {
+	clock := start(t, Rule{Failures: 2, Window: 20 * time.Second})
+	SetServer("s-h2", "192.0.2.1:443")
+	SetServer("s-h3", "192.0.2.1:443")
+	before := *clock
+	*clock = clock.Add(time.Second)
+	fail("s-h3", 2)
+	if !Demoted("s-h3") {
+		t.Fatal("not demoted")
+	}
+	*clock = clock.Add(time.Minute) // the failures are out of the window
+	note("s-h3", true)              // ignored while demoted
+	if !Demoted("s-h3") {
+		t.Fatal("the demotion ended without a health check")
+	}
+	ProbeResult("s-h2", *clock, true)
+	if !Demoted("s-h3") {
+		t.Fatal("a health check of another outbound ended the demotion")
+	}
+	ProbeResult("s-h3", before, true)
+	if !Demoted("s-h3") {
+		t.Fatal("a health check started before the demotion ended it")
+	}
+	ProbeResult("s-h3", *clock, false)
+	if Demoted("s-h3") || SiblingDemoted("s-h2") {
+		t.Fatal("the outbound's next health check result did not end the demotion")
+	}
+	fail("s-h3", 1)
+	if Demoted("s-h3") {
+		t.Fatal("outcomes from before the demotion still count")
+	}
+}
+
+func TestWriterOutcomes(t *testing.T) {
+	start(t, Rule{Failures: 1, ReplyTimeout: 50 * time.Millisecond, MinReplyBytes: 10})
+	var sink buf.Writer = buf.Discard
+	ctx := context.Background()
+
+	replied := Watch(ctx, "replied", "tcp:example.com:443", sink)
+	common.Must(replied.WriteMultiBuffer(bytes(4)))
+	common.Must(replied.WriteMultiBuffer(bytes(6)))
+	Done(replied)
+
+	short := Watch(ctx, "short", "tcp:example.com:443", sink)
+	common.Must(short.WriteMultiBuffer(bytes(4)))
+	Done(short)
+
+	silent := Watch(ctx, "silent", "udp:1.1.1.1:53", sink)
+	time.Sleep(200 * time.Millisecond)
+	Done(silent) // after the timeout: the outcome is already in
+
+	for _, c := range []struct {
+		tag        string
+		ok, failed int
+	}{{"replied", 1, 0}, {"short", 0, 1}, {"silent", 0, 1}} {
+		if ok, failed := outcomes(c.tag); ok != c.ok || failed != c.failed {
+			t.Errorf("%s: %d replied, %d failed; want %d, %d", c.tag, ok, failed, c.ok, c.failed)
+		}
+	}
+}
+
+func TestOffByDefault(t *testing.T) {
+	start(t, Rule{}) // no failures: stays off
+	if Enabled() {
+		t.Fatal("a rule without failures turned tracking on")
+	}
+	if w := Watch(context.Background(), "a", "", buf.Discard); w != buf.Discard {
+		t.Fatal("Watch wrapped a writer while tracking is off")
+	}
+	fail("a", 5)
+	if Demoted("a") {
+		t.Fatal("demoted while tracking is off")
+	}
+}

diff --git a/app/observatory/burst/healthping_cancel_test.go b/app/observatory/burst/healthping_cancel_test.go
new file mode 100644
index 000000000..86da525a8
--- /dev/null
+++ b/app/observatory/burst/healthping_cancel_test.go
@@ -0,0 +1,125 @@
+package burst
+
+import (
+	"context"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport/internet/tagged"
+)
+
+// blackhole makes every ping connect and then get no answer, as through an
+// outbound whose server is blocked.
+func blackhole(t *testing.T) {
+	var mu sync.Mutex
+	var far []net.Conn
+	old := tagged.Dialer
+	tagged.Dialer = func(context.Context, routing.Dispatcher, xnet.Destination, string) (xnet.Conn, error) {
+		near, other := net.Pipe()
+		mu.Lock()
+		far = append(far, other)
+		mu.Unlock()
+		return near, nil
+	}
+	t.Cleanup(func() {
+		tagged.Dialer = old
+		mu.Lock()
+		defer mu.Unlock()
+		for _, c := range far {
+			c.Close()
+		}
+	})
+}
+
+func failures(h *HealthPing, tag string) (all, fail int, ok bool) {
+	h.access.Lock()
+	defer h.access.Unlock()
+	r, ok := h.Results[tag]
+	if !ok {
+		return 0, 0, false
+	}
+	stats := r.Get()
+	return stats.All, stats.Fail, true
+}
+
+// Wanwire: a ping that is under way when the next round cancels its round
+// still counts. Before, its failure went nowhere.
+func TestCancelledRoundKeepsPingsUnderWay(t *testing.T) {
+	blackhole(t)
+	h := NewHealthPing(context.Background(), nil, &HealthPingConfig{
+		Destination:   "http://192.0.2.1:88",
+		Timeout:       int64(200 * time.Millisecond),
+		SamplingCount: 1,
+	})
+	ctx, cancel := context.WithCancel(h.ctx)
+	done := make(chan struct{})
+	go func() {
+		h.doCheck(ctx, []string{"dead"}, 0, 1)
+		close(done)
+	}()
+	time.Sleep(50 * time.Millisecond) // the ping is under way
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("doCheck did not return after the cancel")
+	}
+	if _, fail, ok := failures(h, "dead"); !ok || fail != 1 {
+		t.Fatalf("got ok=%v fail=%d, want the failure of the ping under way stored", ok, fail)
+	}
+}
+
+// Wanwire: a ping that has not started when its round is cancelled does not
+// run, as before.
+func TestCancelledRoundStopsPingsNotStarted(t *testing.T) {
+	blackhole(t)
+	h := NewHealthPing(context.Background(), nil, &HealthPingConfig{
+		Destination:   "http://192.0.2.1:88",
+		Timeout:       int64(200 * time.Millisecond),
+		SamplingCount: 1,
+	})
+	ctx, cancel := context.WithCancel(h.ctx)
+	done := make(chan struct{})
+	go func() {
+		// the one ping is due within the hour, so it has not started
+		h.doCheck(ctx, []string{"later"}, time.Hour, 1)
+		close(done)
+	}()
+	time.Sleep(50 * time.Millisecond)
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("doCheck waited for a ping that never started")
+	}
+	if _, _, ok := failures(h, "later"); ok {
+		t.Fatal("a ping that never started stored a result")
+	}
+}
+
+// Wanwire: a late result of a cancelled round does not replace a result of
+// a ping that started after it; within a round every sample counts.
+func TestLateResultDoesNotReplaceNewer(t *testing.T) {
+	h := NewHealthPing(context.Background(), nil, &HealthPingConfig{SamplingCount: 1})
+	t0 := time.Now()
+	h.putPing(&rtt{handler: "x", value: 50 * time.Millisecond, started: t0.Add(time.Second)}, false)
+	h.putPing(&rtt{handler: "x", value: rttFailed, started: t0}, true)
+	if _, fail, _ := failures(h, "x"); fail != 0 {
+		t.Fatal("a late failure replaced a newer success")
+	}
+	h.putPing(&rtt{handler: "y", value: rttFailed, started: t0}, true)
+	if _, fail, _ := failures(h, "y"); fail != 1 {
+		t.Fatal("a late failure with nothing newer was dropped")
+	}
+
+	h2 := NewHealthPing(context.Background(), nil, &HealthPingConfig{SamplingCount: 2})
+	h2.putPing(&rtt{handler: "z", value: 50 * time.Millisecond, started: t0.Add(time.Second)}, false)
+	h2.putPing(&rtt{handler: "z", value: rttFailed, started: t0}, false)
+	if all, fail, _ := failures(h2, "z"); all != 2 || fail != 1 {
+		t.Fatalf("got all=%d fail=%d, want both samples of the round", all, fail)
+	}
+}
diff --git a/app/observatory/liveness/liveness.go b/app/observatory/liveness/liveness.go
new file mode 100644
index 000000000..89fcc31eb
--- /dev/null
+++ b/app/observatory/liveness/liveness.go
@@ -0,0 +1,332 @@
+// Package liveness tracks whether the user connections through an outbound
+// get replies, so that a leastLoad balancer can stop preferring an outbound
+// that has stopped answering before its next health check finds out
+// (Wanwire patch).
+//
+// A connection has succeeded once at least MinReplyBytes came back through
+// it. It has failed when that did not happen within ReplyTimeout, or when it
+// ended before. When the last Failures outcomes of an outbound within Window
+// are all failures and none of its connections got a reply within the last
+// ReplyTimeout, the outbound is demoted: the balancer passes it over. Nothing
+// is marked dead. The demotion ends with the outbound's next health check
+// result.
+//
+// A reply before the failures holds the demotion back for ReplyTimeout
+// only: in an outage the replies stop when it begins, while a working
+// outbound keeps answering most connections although some get nothing back
+// (an address its server cannot reach, connections the browser drops in a
+// burst of a page load).
+//
+// The outbound alone is demoted, not the server it dials: where UDP is
+// throttled, the h3 outbound of a server fails while its REALITY and h2
+// outbounds work. The balancer uses the server (from the outbound's dials)
+// to spread its picks over servers and to try the other outbounds of a
+// server with a demoted outbound last.
+package liveness
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// Rule says when an outbound is demoted.
+type Rule struct {
+	Failures      int
+	Window        time.Duration
+	ReplyTimeout  time.Duration
+	MinReplyBytes int64
+}
+
+// maxEvents bounds the outcomes kept per outbound within the window.
+const maxEvents = 4096
+
+type event struct {
+	at time.Time
+	ok bool
+}
+
+var (
+	enabled  atomic.Bool
+	mu       sync.Mutex
+	rule     Rule
+	events   = map[string][]event{}   // per outbound tag
+	servers  = map[string]string{}    // outbound tag -> the server it dials
+	demoted  = map[string]time.Time{} // outbound tag -> when it was demoted
+	heldBack = map[string]time.Time{} // outbound tag -> the reply last logged as holding it back
+	now      = time.Now
+)
+
+// Configure turns tracking on with r; a rule without failures leaves it as
+// it is. With several balancers the last one configured wins.
+func Configure(r Rule) {
+	if r.Failures <= 0 {
+		return
+	}
+	if r.Window <= 0 {
+		r.Window = 20 * time.Second
+	}
+	if r.ReplyTimeout <= 0 {
+		r.ReplyTimeout = 5 * time.Second
+	}
+	if r.MinReplyBytes <= 0 {
+		r.MinReplyBytes = 1
+	}
+	mu.Lock()
+	rule = r
+	mu.Unlock()
+	enabled.Store(true)
+	errors.LogInfo(context.Background(), "liveness: an outbound is demoted after ", r.Failures,
+		" connections in a row without a reply within ", r.Window, " (reply timeout ",
+		r.ReplyTimeout, ", at least ", r.MinReplyBytes, " bytes)")
+}
+
+// Enabled reports whether a balancer turned tracking on.
+func Enabled() bool {
+	return enabled.Load()
+}
+
+func currentRule() Rule {
+	mu.Lock()
+	defer mu.Unlock()
+	return rule
+}
+
+// SetServer records the server an outbound dials (its first dial counts).
+func SetServer(tag, server string) {
+	if !enabled.Load() || tag == "" || server == "" {
+		return
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if _, ok := servers[tag]; !ok {
+		servers[tag] = server
+	}
+}
+
+// server is the server an outbound dials, or a key of the outbound's own
+// while it has not dialed yet. The caller holds mu.
+func server(tag string) string {
+	if s, ok := servers[tag]; ok {
+		return s
+	}
+	return "outbound " + tag
+}
+
+// Server returns the server an outbound dials, or a key of its own while it
+// has not dialed yet, so that a balancer can spread over servers.
+func Server(tag string) string {
+	mu.Lock()
+	defer mu.Unlock()
+	return server(tag)
+}
+
+// SiblingDemoted reports whether another outbound of tag's server is
+// demoted: the balancer then tries tag after the outbounds of other servers.
+func SiblingDemoted(tag string) bool {
+	if !enabled.Load() {
+		return false
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	s, ok := servers[tag]
+	if !ok {
+		return false
+	}
+	for other := range demoted {
+		if other != tag && servers[other] == s {
+			return true
+		}
+	}
+	return false
+}
+
+// siblings lists the other outbounds of tag's server. The caller holds mu.
+func siblings(tag string) []string {
+	var tags []string
+	if s, ok := servers[tag]; ok {
+		for other, os := range servers {
+			if other != tag && os == s {
+				tags = append(tags, other)
+			}
+		}
+	}
+	sort.Strings(tags)
+	return tags
+}
+
+// note records the outcome of one connection through tag; it reports false
+// when the outcome does not count because tag is demoted.
+func note(tag string, ok bool) bool {
+	t := now()
+	mu.Lock()
+	defer mu.Unlock()
+	if _, out := demoted[tag]; out {
+		return false // nothing changes until its next health check
+	}
+	ev := append(events[tag], event{at: t, ok: ok})
+	if len(ev) > maxEvents {
+		ev = append(ev[:0], ev[len(ev)-maxEvents:]...)
+	}
+	events[tag] = trim(ev, t)
+	return true
+}
+
+// trim drops the outcomes older than the window. The caller holds mu.
+func trim(ev []event, t time.Time) []event {
+	cut := 0
+	for cut < len(ev) && t.Sub(ev[cut].at) > rule.Window {
+		cut++
+	}
+	if cut > 0 {
+		ev = append(ev[:0], ev[cut:]...)
+	}
+	return ev
+}
+
+// Demoted reports whether the balancer should pass over tag. The first call
+// that finds the rule met for tag demotes it.
+func Demoted(tag string) bool {
+	if !enabled.Load() {
+		return false
+	}
+	t := now()
+	mu.Lock()
+	defer mu.Unlock()
+	if _, out := demoted[tag]; out {
+		return true
+	}
+	ev := trim(events[tag], t)
+	events[tag] = ev
+	last := len(ev) - 1 // ends at the last reply within the window, if any
+	for last >= 0 && !ev[last].ok {
+		last--
+	}
+	failures := len(ev) - 1 - last
+	if failures < rule.Failures {
+		return false
+	}
+	if last >= 0 && t.Sub(ev[last].at) < rule.ReplyTimeout {
+		if !heldBack[tag].Equal(ev[last].at) {
+			heldBack[tag] = ev[last].at
+			errors.LogDebug(context.Background(), "liveness: ", failures,
+				" connections in a row through ", tag, " got no reply, but another got one ",
+				t.Sub(ev[last].at).Round(time.Millisecond), " ago; not passing it over yet")
+		}
+		return false
+	}
+	delete(heldBack, tag)
+	demoted[tag] = t
+	others := ""
+	if sib := siblings(tag); len(sib) > 0 {
+		others = "; the other outbounds of " + server(tag) + " (" + strings.Join(sib, ", ") +
+			") go after those of other servers"
+	}
+	errors.LogWarning(context.Background(), "liveness: ", failures,
+		" connections in a row through ", tag, " got no reply; passing it over until its next "+
+			"health check", others)
+	return true
+}
+
+// ProbeResult ends the demotion of tag when a health check of tag that
+// started after the demotion has a result. A failed one leaves the outbound
+// to the health checks, which then count it out; the outcomes collected
+// before are dropped either way.
+func ProbeResult(tag string, started time.Time, ok bool) {
+	if !enabled.Load() {
+		return
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	at, out := demoted[tag]
+	if !out || started.Before(at) {
+		return
+	}
+	result := "answered"
+	if !ok {
+		result = "failed"
+	}
+	errors.LogWarning(context.Background(), "liveness: ", tag, " has a new health check result (",
+		result, ") ", now().Sub(at).Round(time.Second), " after its demotion; the demotion ends")
+	delete(demoted, tag)
+	delete(events, tag)
+}
+
+// Writer watches the replies of one connection through an outbound: the
+// outbound writes them into it.
+type Writer struct {
+	buf.Writer
+	ctx      context.Context
+	tag      string
+	dest     string
+	min      int64
+	started  time.Time
+	got      atomic.Int64
+	finished atomic.Bool
+}
+
+// Watch wraps w, the writer an outbound puts the replies of one connection
+// to dest into, while tracking is on. ctx is the connection's, for the debug
+// log of the outcome.
+func Watch(ctx context.Context, tag, dest string, w buf.Writer) buf.Writer {
+	if !enabled.Load() || tag == "" {
+		return w
+	}
+	r := currentRule()
+	lw := &Writer{Writer: w, ctx: ctx, tag: tag, dest: dest, min: r.MinReplyBytes, started: now()}
+	time.AfterFunc(r.ReplyTimeout, func() { lw.finish(false, true) })
+	return lw
+}
+
+// Done tells the watch on w, if any, that the outbound is through with the
+// connection: one that ends before its reply has failed.
+func Done(w buf.Writer) {
+	if lw, ok := w.(*Writer); ok {
+		lw.finish(false, false)
+	}
+}
+
+// finish records the outcome once, and logs it at debug level so that a
+// rule can be replayed from a log.
+func (w *Writer) finish(ok, timedOut bool) {
+	if !w.finished.CompareAndSwap(false, true) {
+		return
+	}
+	counted := note(w.tag, ok)
+	elapsed := now().Sub(w.started).Round(time.Millisecond)
+	what := " ended after " + elapsed.String() + " without a reply"
+	if ok {
+		what = " replied after " + elapsed.String()
+	} else if timedOut {
+		what = " got no reply in " + elapsed.String()
+	}
+	if !counted {
+		what += "; not counted while demoted"
+	}
+	errors.LogDebug(w.ctx, "liveness: ", w.tag, " ", w.dest, what)
+}
+
+// WriteMultiBuffer implements buf.Writer.
+func (w *Writer) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if !w.finished.Load() && w.got.Add(int64(mb.Len())) >= w.min {
+		w.finish(true, false)
+	}
+	return w.Writer.WriteMultiBuffer(mb)
+}
+
+// Close implements common.Closable.
+func (w *Writer) Close() error {
+	return common.Close(w.Writer)
+}
+
+// Interrupt implements common.Interruptible.
+func (w *Writer) Interrupt() {
+	common.Interrupt(w.Writer)
+}
